package test:vector;

// See https://component-model.bytecodealliance.org/design/wit.html for more details about the WIT syntax

interface test-vector-api {
  add: func(value: u64);
  get: func() -> u64;
}

world test-vector {
  import golem:vector/vectors@1.0.0;
  import golem:vector/connection@1.0.0;
  import golem:vector/collections@1.0.0;
  import golem:vector/search@1.0.0;
  import golem:vector/search-extended@1.0.0;
  import golem:vector/analytics@1.0.0;
  import golem:vector/namespaces@1.0.0;
  export test-vector-api;
}
